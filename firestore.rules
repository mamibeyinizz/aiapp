rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserRole() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? (getUserDoc().data.get('rol', '') != ''
            ? getUserDoc().data.get('rol', '')
            : getUserDoc().data.get('role', ''))
        : "";
    }

    function getUserBranchId() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? getUserDoc().data.get('branchId', '')
        : "";
    }

    function isAdmin() {
      return isAuthenticated() && (
        getUserRole() in [
          "admin", "Admin", "ADMIN",
          "yonetici", "Yonetici", "YONETICI",
          "yönetici", "Yönetici", "YÖNETİCİ",
          "administrator", "Administrator", "ADMINISTRATOR",
          "kurucu", "Kurucu", "KURUCU",
          "patron", "Patron", "PATRON",
          "sistem", "Sistem", "SİSTEM"
        ] ||
        request.auth.token.get('admin', false) == true ||
        request.auth.token.get('role', '') in ["admin", "yonetici", "yönetici", "administrator"] ||
        request.auth.token.get('email', '') in ['admin@qrservis.local', 'muhammedulusoyresmi@gmail.com'] ||
        request.auth.token.get('email', '').matches('(?i).*admin.*') ||
        request.auth.token.get('email', '').matches('(?i).*yonetici.*') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          getUserDoc().data.get('rol', '') in [
            'admin', 'Admin', 'ADMIN',
            'yonetici', 'Yonetici', 'YONETICI',
            'yönetici', 'Yönetici', 'YÖNETİCİ',
            'administrator', 'Administrator', 'ADMINISTRATOR',
            'kurucu', 'Kurucu', 'patron', 'Patron', 'sistem', 'Sistem'
          ] ||
          getUserDoc().data.get('role', '') in [
            'admin', 'Admin', 'ADMIN',
            'yonetici', 'Yonetici', 'YONETICI',
            'yönetici', 'Yönetici', 'YÖNETİCİ',
            'administrator', 'Administrator', 'ADMINISTRATOR',
            'kurucu', 'Kurucu', 'patron', 'Patron', 'sistem', 'Sistem'
          ] ||
          getUserDoc().data.get('kullaniciAdi', '') in ['admin', 'Admin', 'ADMIN', 'yonetici', 'Yonetici', 'yönetici', 'Yönetici']
        ))
      );
    }

    function isManager() {
      return isAuthenticated() && (
        getUserRole() in ["mudur", "Mudur", "MÜDÜR", "manager", "Manager", "MANAGER"] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          getUserDoc().data.get('rol', '') in ["mudur", "Mudur", "MÜDÜR", "manager", "Manager", "MANAGER"] ||
          getUserDoc().data.get('role', '') in ["mudur", "Mudur", "MÜDÜR", "manager", "Manager", "MANAGER"]
        ))
      );
    }

    function isWaiter() {
      return isAuthenticated() && !isAdmin() && !isManager() && (
        getUserRole() in ["garson", "Garson", "GARSON", "waiter", "Waiter", "WAITER"] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          getUserDoc().data.get('rol', '') in ['garson', 'Garson', 'GARSON', 'waiter', 'Waiter', 'WAITER'] ||
          getUserDoc().data.get('role', '') in ['garson', 'Garson', 'GARSON', 'waiter', 'Waiter', 'WAITER']
        ))
      );
    }

    // Users
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        request.auth.uid == userId ||
        isAdmin() ||
        request.resource.data.rol != null ||
        request.resource.data.role != null
      );
    }

    // Branches
    match /branches/{branchId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (isAdmin() || isManager());
    }

    // Tables
    match /tables/{tableId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Calls (Waiters and Managers)
    match /calls/{callId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // Shifts & Breaks
    match /shifts/{shiftId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();

      match /breaks/{breakId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAuthenticated();
      }
    }

    // Manager & Admin -> Personnel Announcements
    match /announcements/{announcementId} {
      // 1. Single Document Read (getDoc)
      allow get: if isAuthenticated() && (
        isAdmin() ||
        (isManager() && (
          resource.data.branchId in [getUserBranchId(), 'all'] ||
          resource.data.get('targetBranchId', '') in [getUserBranchId(), 'all'] ||
          resource.data.get('targetType', '') == 'all_staff' ||
          resource.data.senderUid == request.auth.uid
        )) ||
        (isWaiter() && (
          resource.data.branchId in [getUserBranchId(), 'all'] ||
          resource.data.get('targetBranchId', '') in [getUserBranchId(), 'all'] ||
          resource.data.get('targetType', '') in ['all', 'all_staff', 'branch'] ||
          resource.data.get('targetUserUid', '') == request.auth.uid ||
          resource.data.get('targetUserId', '') == request.auth.uid
        )) ||
        // Fallback: sender or direct recipient can always read their own announcement
        resource.data.senderUid == request.auth.uid ||
        resource.data.get('targetUserUid', '') == request.auth.uid ||
        resource.data.get('targetUserId', '') == request.auth.uid
      );

      // 2. Collection Query Listing (queries)
      // Allows Admin, Manager, and Waiter queries matching active announcements
      allow list: if isAuthenticated() && (
        isAdmin() ||
        resource.data.get('targetUserUid', '') == request.auth.uid ||
        resource.data.get('targetUserId', '') == request.auth.uid ||
        resource.data.senderUid == request.auth.uid ||
        (resource.data.branchId is string && resource.data.active == true)
      );

      // Only Admin and authorized Manager can create announcements!
      // Garson CANNOT create!
      allow create: if isAuthenticated() &&
        request.resource.data.senderUid == request.auth.uid &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.message is string &&
        request.resource.data.message.size() > 0 &&
        request.resource.data.branchId is string &&
        (
          // 1. Admin can create announcements with full flexibility:
          // for all branches ("all"), all staff, specific branch, or specific user
          isAdmin() ||
          // 2. Manager can create ONLY for their assigned branch:
          // cannot target "all", cannot target "all_staff", senderRole must be manager, branch must match
          (
            isManager() &&
            request.resource.data.get('senderRole', '') in ['mudur', 'Mudur', 'MÜDÜR', 'manager'] &&
            request.resource.data.branchId == getUserBranchId() &&
            request.resource.data.get('targetBranchId', getUserBranchId()) == getUserBranchId() &&
            request.resource.data.branchId != "all" &&
            request.resource.data.get('targetType', '') != "all_staff"
          )
        );

      // Update: Admin or sender can update, or waiters can mark as read by appending UID to readUids
      allow update: if isAuthenticated() && (
        isAdmin() ||
        resource.data.senderUid == request.auth.uid ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readUids']) &&
         request.auth.uid in request.resource.data.readUids)
      );

      // Delete: Admin or original sender
      allow delete: if isAuthenticated() && (
        isAdmin() ||
        resource.data.senderUid == request.auth.uid
      );

      // Per-user read state subcollection
      match /reads/{uid} {
        allow read: if isAuthenticated();
        // Waiter can ONLY create/update their OWN read record!
        allow write: if isAuthenticated() && request.auth.uid == uid;
      }
    }

    // Audit logs (Admin/Manager operation history)
    match /audit_logs/{logId} {
      allow read, create: if isAuthenticated();
    }

    // Daily tasks (Operational checklists)
    match /daily_tasks/{taskId} {
      allow read, create, update, delete: if isAuthenticated();
    }
  }
}
