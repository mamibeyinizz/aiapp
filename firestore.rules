rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ───────── Yardımcılar ─────────
    function signedIn() {
      return request.auth != null;
    }

    function hasProfile() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Eski kayıtlarda "rol", bazılarında "role" alanı var.
    function myRole() {
      return hasProfile()
        ? string(me().get('rol', '') != '' ? me().get('rol', '') : me().get('role', '')).lower()
        : '';
    }

    function myBranch() {
      return hasProfile() ? me().get('branchId', '') : '';
    }

    function isActiveUser() {
      return hasProfile() && me().get('aktif', true) != false;
    }

    function isAdmin() {
      return isActiveUser() &&
        myRole() in ['admin', 'yonetici', 'yönetici', 'administrator', 'kurucu', 'patron', 'sistem'];
    }

    function isManager() {
      return isActiveUser() && myRole() in ['mudur', 'müdür', 'manager'];
    }

    function isWaiter() {
      return isActiveUser() && myRole() in ['garson', 'waiter'];
    }

    function isStaff() {
      return isAdmin() || isManager() || isWaiter();
    }

    function isWaiterRole(r) {
      return string(r).lower() in ['garson', 'waiter'];
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ───────── users ─────────
    // Kullanıcı oluşturma WordPress (Admin SDK) tarafından yapılır; istemci rol yazamaz.
    match /users/{userId} {
      allow read: if signedIn() && (
        request.auth.uid == userId ||
        isAdmin() ||
        (isStaff() && resource.data.branchId == myBranch())
      );

      allow create: if isAdmin();

      allow update: if signedIn() && (
        // Kendi dokümanında yalnızca bu alanlar
        (request.auth.uid == userId &&
          changedKeys().hasOnly(['fcmToken', 'passwordUpdatedAt'])) ||
        isAdmin() ||
        // Müdür: kendi şubesindeki garsonun yalnızca bu alanları
        (isManager() &&
          resource.data.branchId == myBranch() &&
          isWaiterRole(resource.data.get('rol', resource.data.get('role', ''))) &&
          request.resource.data.get('rol', '') == resource.data.get('rol', '') &&
          request.resource.data.get('branchId', '') == resource.data.get('branchId', '') &&
          changedKeys().hasOnly(['ad', 'aktif', 'passwordUpdatedAt']))
      );

      allow delete: if isAdmin();
    }

    // ───────── branches ─────────
    // NOT: apiKey alanı bu dokümanda; giriş yapan herkes okuyabilir.
    // İleride apiKey'i ayrı bir alt koleksiyona taşıyın.
    match /branches/{branchId} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isManager() &&
        branchId == myBranch() &&
        changedKeys().hasOnly(['locationCheckEnabled', 'lat', 'lng', 'radius', 'address'])
      );
    }

    // ───────── tables ─────────
    match /tables/{tableId} {
      allow read: if signedIn();
      allow create: if isAdmin() ||
        (isManager() && request.resource.data.branchId == myBranch());
      allow update: if false;
      allow delete: if isAdmin() ||
        (isManager() && resource.data.branchId == myBranch());
    }

    // ───────── calls ─────────
    match /calls/{callId} {
      allow read: if signedIn() && (
        isAdmin() ||
        (isStaff() && resource.data.branchId == myBranch())
      );

      // Müşteri tarafı çağrıyı oluşturuyor (oturumlu istemci veya sunucu).
      // Şekil doğrulaması: yalnızca "bekliyor" durumunda yeni çağrı.
      allow create: if signedIn() &&
        request.resource.data.branchId is string &&
        request.resource.data.branchId.size() > 0 &&
        request.resource.data.masaNo is string &&
        request.resource.data.tip in ['garson', 'hesap', 'siparis'] &&
        request.resource.data.durum == 'bekliyor';

      allow update: if signedIn() && (isAdmin() ||
        (isStaff() && resource.data.branchId == myBranch())) && (
        // Onay
        (resource.data.durum == 'bekliyor' &&
          request.resource.data.durum == 'onaylandi' &&
          request.resource.data.onaylayanUid == request.auth.uid &&
          changedKeys().hasOnly(['durum', 'onaylayanUid', 'onaylayanAd', 'onaylandiAt'])) ||
        // İptal
        (resource.data.durum == 'bekliyor' &&
          request.resource.data.durum == 'iptal' &&
          changedKeys().hasOnly(['durum', 'iptalNedeni', 'iptalEdenAd', 'iptalAt'])) ||
        // Sipariş teslim aşaması
        (resource.data.durum == 'onaylandi' &&
          resource.data.tip == 'siparis' &&
          changedKeys().hasOnly(['teslimDurumu', 'hazirlaniyorAt', 'teslimAt'])) ||
        // Ödeme yöntemi
        (resource.data.durum == 'onaylandi' &&
          resource.data.tip == 'hesap' &&
          changedKeys().hasOnly(['odemeYontemi', 'odemeAt']))
      );

      allow delete: if isAdmin();
    }

    // ───────── shifts ─────────
    // Okuma tüm aktif personele açık: müdürün "garsonUid" ile yaptığı sorgular
    // şube filtresi içermediği için kurallar şubeyi kanıtlayamaz.
    match /shifts/{shiftId} {
      allow read: if isStaff();

      allow create: if isWaiter() &&
        request.resource.data.garsonUid == request.auth.uid &&
        request.resource.data.branchId == myBranch() &&
        request.resource.data.durum == 'acik';

      allow update: if isAdmin() || (
        request.resource.data.garsonUid == resource.data.garsonUid &&
        request.resource.data.branchId == resource.data.branchId && (
          resource.data.garsonUid == request.auth.uid ||
          (isManager() && resource.data.branchId == myBranch())
        )
      );

      allow delete: if isAdmin();

      match /molalar/{breakId} {
        allow read: if isStaff();
        allow create, update: if isAdmin() || (isStaff() && (
          get(/databases/$(database)/documents/shifts/$(shiftId)).data.garsonUid == request.auth.uid ||
          (isManager() &&
            get(/databases/$(database)/documents/shifts/$(shiftId)).data.branchId == myBranch())
        ));
        allow delete: if isAdmin();
      }

      // Eski veri uyumluluğu
      match /breaks/{breakId} {
        allow read: if isStaff();
        allow create, update: if isAdmin() || (isStaff() && (
          get(/databases/$(database)/documents/shifts/$(shiftId)).data.garsonUid == request.auth.uid ||
          (isManager() &&
            get(/databases/$(database)/documents/shifts/$(shiftId)).data.branchId == myBranch())
        ));
        allow delete: if isAdmin();
      }
    }

    // ───────── announcements ─────────
    match /announcements/{announcementId} {
      allow get: if signedIn() && (
        isAdmin() ||
        (isManager() && (
          resource.data.branchId in [myBranch(), 'all'] ||
          resource.data.get('targetBranchId', '') in [myBranch(), 'all'] ||
          resource.data.get('targetType', '') == 'all_staff' ||
          resource.data.senderUid == request.auth.uid
        )) ||
        (isWaiter() && (
          resource.data.branchId in [myBranch(), 'all'] ||
          resource.data.get('targetBranchId', '') in [myBranch(), 'all'] ||
          resource.data.get('targetType', '') in ['all', 'all_staff', 'branch'] ||
          resource.data.get('targetUserUid', '') == request.auth.uid ||
          resource.data.get('targetUserId', '') == request.auth.uid
        )) ||
        resource.data.senderUid == request.auth.uid ||
        resource.data.get('targetUserUid', '') == request.auth.uid ||
        resource.data.get('targetUserId', '') == request.auth.uid
      );

      allow list: if signedIn() && (
        isAdmin() ||
        resource.data.get('targetUserUid', '') == request.auth.uid ||
        resource.data.get('targetUserId', '') == request.auth.uid ||
        resource.data.senderUid == request.auth.uid ||
        (isStaff() && resource.data.branchId is string && resource.data.active == true)
      );

      allow create: if signedIn() &&
        request.resource.data.senderUid == request.auth.uid &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.message is string &&
        request.resource.data.message.size() > 0 &&
        request.resource.data.branchId is string &&
        (
          isAdmin() ||
          (
            isManager() &&
            request.resource.data.branchId == myBranch() &&
            request.resource.data.get('targetBranchId', myBranch()) == myBranch() &&
            request.resource.data.get('targetType', '') != 'all_staff'
          )
        );

      allow update: if signedIn() && (
        isAdmin() ||
        resource.data.senderUid == request.auth.uid ||
        (isStaff() &&
          changedKeys().hasOnly(['readUids']) &&
          request.auth.uid in request.resource.data.readUids)
      );

      allow delete: if signedIn() && (
        isAdmin() ||
        resource.data.senderUid == request.auth.uid
      );

      match /reads/{uid} {
        allow read: if isStaff();
        allow write: if isStaff() && request.auth.uid == uid;
      }
    }

    // ───────── audit_logs ─────────
    match /audit_logs/{logId} {
      allow read: if isAdmin() ||
        (isManager() && resource.data.branchId == myBranch());
      allow create: if isStaff() && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    // ───────── daily_tasks (uygulamada kullanılmıyor) ─────────
    match /daily_tasks/{taskId} {
      allow read, write: if isAdmin();
    }
  }
}
