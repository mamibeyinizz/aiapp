rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // Yardımcılar
    // ------------------------------------------------------------------
    // Sunucu (WP, service account) kurallardan etkilenmez; calls kayıtlarını
    // müşteri siparişi ve personel siparişi olarak SUNUCU yazar.

    function signedIn() {
      return request.auth != null;
    }

    function meExists() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Pasif (aktif == false) hesap hiçbir şey yapamaz. Alan yoksa aktif sayılır.
    function isActive() {
      return meExists() && me().get('aktif', true) != false;
    }

    function myRol() {
      return meExists() ? me().get('rol', me().get('role', '')) : '';
    }

    function myBranch() {
      return meExists() ? me().get('branchId', '') : '';
    }

    function hasRole(r) {
      return isActive() && (myRol() == r || r in me().get('roller', []));
    }

    // Yönetici. Rol YALNIZCA users/{uid} dokümanından gelir. E-posta adının
    // içinde "admin" geçmesi artık yetki vermez (müdür "admin2" kullanıcı adı
    // açıp yönetici olabiliyordu). İlk yönetici hesabı için tek sabit e-posta
    // kalır; kişisel e-posta yalnızca doğrulanmışsa geçerlidir.
    function isAdmin() {
      return signedIn() && (
        (isActive() && myRol() in [
          'admin', 'Admin', 'ADMIN',
          'yonetici', 'Yonetici', 'yönetici', 'Yönetici',
          'administrator', 'Administrator',
          'kurucu', 'Kurucu', 'patron', 'Patron', 'sistem', 'Sistem'
        ]) ||
        request.auth.token.get('email', '') == 'admin@qrservis.local' ||
        (request.auth.token.get('email', '') == 'muhammedulusoyresmi@gmail.com' &&
         request.auth.token.get('email_verified', false) == true)
      );
    }

    function isManager() {
      return isActive() && myRol() in ['mudur', 'Mudur', 'MÜDÜR', 'müdür', 'manager', 'Manager', 'MANAGER'];
    }

    function isWaiter() {
      return hasRole('garson') || hasRole('mutfak') || hasRole('bar');
    }

    function sameBranch(b) {
      return isActive() && b is string && b != '' && b == myBranch();
    }

    // Müdür, yalnızca KENDİ şubesinin personelini (garson/mutfak/bar) yönetir.
    function staffRoles() {
      return ['garson', 'mutfak', 'bar'];
    }

    // ------------------------------------------------------------------
    // users
    // ------------------------------------------------------------------
    match /users/{userId} {
      allow get: if signedIn() && (
        request.auth.uid == userId ||
        isAdmin() ||
        sameBranch(resource.data.get('branchId', ''))
      );
      allow list: if signedIn() && (
        isAdmin() ||
        sameBranch(resource.data.get('branchId', ''))
      );

      // Kullanıcı kayıtlarını (Auth + Firestore) yalnızca WP sunucusu oluşturur.
      // İstemci yalnızca yönetici olarak oluşturabilir.
      allow create: if isAdmin();

      allow update: if signedIn() && (
        isAdmin() ||
        // Kendi kaydında yetki alanlarına dokunamaz (fcmToken vb. serbest).
        (request.auth.uid == userId &&
         !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['rol', 'role', 'roller', 'branchId', 'aktif', 'kullaniciAdi', 'uid'])) ||
        // Müdür: kendi şubesindeki PERSONEL kaydını düzenler.
        (isManager() &&
         sameBranch(resource.data.get('branchId', '')) &&
         resource.data.get('rol', '') in staffRoles() &&
         request.resource.data.get('rol', '') in staffRoles() &&
         request.resource.data.get('roller', []).hasOnly(staffRoles()) &&
         request.resource.data.branchId == resource.data.branchId)
      );

      allow delete: if isAdmin() || (
        isManager() &&
        sameBranch(resource.data.get('branchId', '')) &&
        resource.data.get('rol', '') in staffRoles()
      );
    }

    // ------------------------------------------------------------------
    // branches
    // ------------------------------------------------------------------
    // UYARI: şube dokümanında apiKey bulunur ve oturum açmış her kullanıcı
    // okuyabilir (uygulama şube bilgisini okuyor). Anahtarı ayrı bir
    // yönetici-only dokümana taşımak sonraki iştir.
    match /branches/{branchId} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isManager() &&
        branchId == myBranch() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'mutfakAktif', 'barAktif', 'mutfakVardiyaZorunlu', 'barVardiyaZorunlu',
          'lat', 'lng', 'radius', 'locationCheckEnabled', 'address'
        ])
      );
    }

    // ------------------------------------------------------------------
    // tables
    // ------------------------------------------------------------------
    match /tables/{tableId} {
      allow read: if isAdmin() || sameBranch(resource.data.get('branchId', ''));
      allow create: if isAdmin() || (isManager() && sameBranch(request.resource.data.get('branchId', '')));
      allow update, delete: if isAdmin() || (isManager() && sameBranch(resource.data.get('branchId', '')));
    }

    // ------------------------------------------------------------------
    // calls (sipariş / garson / hesap çağrıları)
    // ------------------------------------------------------------------
    // Not: kural değerlendirme sınırı (1000 ifade) nedeniyle yardımcılar
    // kullanıcı belgesini PARAMETRE olarak alır; her çağrıda yeniden get() yok.
    match /calls/{callId} {
      allow read: if isAdmin() || sameBranch(resource.data.get('branchId', ''));

      // Siparişleri / çağrıları yalnızca WP sunucusu oluşturur.
      allow create: if false;

      allow update: if signedIn() && meExists() &&
        callUpdateOk(me(), resource.data, request.resource.data, request.auth.uid, isAdmin());

      allow delete: if isAdmin();
    }

    function callUpdateOk(u, old, nw, uid, admin) {
      let rol = u.get('rol', '');
      let roller = u.get('roller', []);
      let active = u.get('aktif', true) != false;
      let sube = old.get('branchId', '');
      let branchOk = active && sube != '' && sube == u.get('branchId', '');
      let mgr = active && rol in ['mudur', 'Mudur', 'MÜDÜR', 'müdür', 'manager', 'Manager', 'MANAGER'];
      let garson = active && (rol == 'garson' || 'garson' in roller);
      let keys = nw.diff(old).affectedKeys();
      return (admin || branchOk) && nw.get('branchId', '') == sube && (
        ((garson || mgr || admin) && approverOk(keys, old, nw, uid, mgr || admin)) ||
        (active && stationUpdateOk(keys, old, nw, uid, rol, roller))
      );
    }

    // Garson / müdür / yönetici: onay, teslim, iptal.
    function approverOk(keys, old, nw, uid, mgr) {
      return keys.hasOnly([
          'durum', 'onaylayanUid', 'onaylayanAd', 'onaylandiAt', 'istasyonlar',
          'iptalNedeni', 'iptalEdenAd', 'iptalAt'
        ]) &&
        (!('durum' in keys) || (
          // onay: yalnızca bekleyen siparişi, kendi adına
          (nw.durum == 'onaylandi' && old.durum == 'bekliyor' && nw.get('onaylayanUid', '') == uid) ||
          // teslim
          (nw.durum == 'teslim' && old.durum in ['onaylandi', 'hazirlaniyor', 'hazir']) ||
          // iptal: garson yalnızca hazırlık başlamadan; müdür/yönetici sonrasında da
          (nw.durum == 'iptal' && (
            old.durum in ['bekliyor', 'onaylandi'] ||
            (mgr && old.durum in ['hazirlaniyor', 'hazir'])
          ))
        )) &&
        // istasyonlar yalnızca onay anında ve yalnızca {durum:'bekliyor'} olarak kurulur.
        (!('istasyonlar' in keys) || (
          old.durum == 'bekliyor' &&
          !('istasyonlar' in old) &&
          nw.durum == 'onaylandi' &&
          nw.istasyonlar.keys().hasOnly(['mutfak', 'bar']) &&
          nw.istasyonlar.get('mutfak', {'durum': 'bekliyor'}).keys().hasOnly(['durum']) &&
          nw.istasyonlar.get('bar', {'durum': 'bekliyor'}).keys().hasOnly(['durum']) &&
          nw.istasyonlar.get('mutfak', {'durum': 'bekliyor'}).durum == 'bekliyor' &&
          nw.istasyonlar.get('bar', {'durum': 'bekliyor'}).durum == 'bekliyor'
        ));
    }

    // Mutfak / bar: yalnızca KENDİ istasyonunun durumunu ilerletir.
    function stationUpdateOk(keys, old, nw, uid, rol, roller) {
      return keys.hasOnly(['istasyonlar', 'durum']) &&
        (!('durum' in keys) || nw.durum in ['hazirlaniyor', 'hazir']) &&
        ('istasyonlar' in old) && ('istasyonlar' in nw) && (
          ((rol == 'mutfak' || 'mutfak' in roller) && stationOk('mutfak', old.istasyonlar, nw.istasyonlar, uid)) ||
          ((rol == 'bar' || 'bar' in roller) && stationOk('bar', old.istasyonlar, nw.istasyonlar, uid))
        );
    }

    function stationOk(st, a, b, uid) {
      return (st in a) && (st in b) &&
        b.diff(a).affectedKeys().hasOnly([st]) &&
        b[st].diff(a[st]).affectedKeys().hasOnly([
          'durum', 'hazirlayanUid', 'hazirlayanAd', 'basladiAt', 'hazirAt'
        ]) && (
          // bekliyor -> hazirlaniyor (alan kendisini yazar)
          (a[st].durum == 'bekliyor' && b[st].durum == 'hazirlaniyor' && b[st].get('hazirlayanUid', '') == uid) ||
          // hazirlaniyor -> hazir
          (a[st].durum == 'hazirlaniyor' && b[st].durum == 'hazir')
        );
    }

    // ------------------------------------------------------------------
    // shifts
    // ------------------------------------------------------------------
    match /shifts/{shiftId} {
      allow read: if signedIn() && (
        isAdmin() ||
        sameBranch(resource.data.get('branchId', '')) ||
        resource.data.get('garsonUid', '') == request.auth.uid
      );
      allow create: if isAdmin() || sameBranch(request.resource.data.get('branchId', ''));
      allow update, delete: if isAdmin() ||
        sameBranch(resource.data.get('branchId', '')) ||
        resource.data.get('garsonUid', '') == request.auth.uid;

      function shiftParentOk() {
        let p = get(/databases/$(database)/documents/shifts/$(shiftId)).data;
        return isAdmin() || sameBranch(p.get('branchId', '')) || p.get('garsonUid', '') == request.auth.uid;
      }

      // Uygulama mola kayıtlarını "molalar" altında yazar; eski adı "breaks".
      match /molalar/{id} {
        allow read, write: if signedIn() && shiftParentOk();
      }
      match /breaks/{id} {
        allow read, write: if signedIn() && shiftParentOk();
      }
    }

    // ------------------------------------------------------------------
    // announcements (kuralları değişmedi; yalnızca rol yardımcıları ortak)
    // ------------------------------------------------------------------
    match /announcements/{announcementId} {
      allow get: if isAuthenticatedLegacy() && (
        isAdmin() ||
        (isManager() && (
          resource.data.branchId in [myBranch(), 'all'] ||
          resource.data.get('targetBranchId', '') in [myBranch(), 'all'] ||
          resource.data.get('targetType', '') == 'all_staff' ||
          resource.data.senderUid == request.auth.uid
        )) ||
        (isWaiter() && (
          resource.data.branchId in [myBranch(), 'all'] ||
          resource.data.get('targetBranchId', '') in [myBranch(), 'all'] ||
          resource.data.get('targetType', '') in ['all', 'all_staff', 'branch'] ||
          resource.data.get('targetUserUid', '') == request.auth.uid ||
          resource.data.get('targetUserId', '') == request.auth.uid
        )) ||
        resource.data.senderUid == request.auth.uid ||
        resource.data.get('targetUserUid', '') == request.auth.uid ||
        resource.data.get('targetUserId', '') == request.auth.uid
      );

      allow list: if signedIn() && (
        isAdmin() ||
        resource.data.get('targetUserUid', '') == request.auth.uid ||
        resource.data.get('targetUserId', '') == request.auth.uid ||
        resource.data.senderUid == request.auth.uid ||
        (resource.data.branchId is string && resource.data.active == true)
      );

      allow create: if signedIn() &&
        request.resource.data.senderUid == request.auth.uid &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.message is string &&
        request.resource.data.message.size() > 0 &&
        request.resource.data.branchId is string &&
        (
          isAdmin() ||
          (
            isManager() &&
            request.resource.data.get('senderRole', '') in ['mudur', 'Mudur', 'MÜDÜR', 'manager'] &&
            request.resource.data.branchId == myBranch() &&
            request.resource.data.get('targetBranchId', myBranch()) == myBranch() &&
            request.resource.data.branchId != 'all' &&
            request.resource.data.get('targetType', '') != 'all_staff'
          )
        );

      allow update: if signedIn() && (
        isAdmin() ||
        resource.data.senderUid == request.auth.uid ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readUids']) &&
         request.auth.uid in request.resource.data.readUids)
      );

      allow delete: if signedIn() && (
        isAdmin() ||
        resource.data.senderUid == request.auth.uid
      );

      match /reads/{uid} {
        allow read: if signedIn();
        allow write: if signedIn() && request.auth.uid == uid;
      }
    }

    function isAuthenticatedLegacy() {
      return signedIn();
    }

    // ------------------------------------------------------------------
    // audit_logs
    // ------------------------------------------------------------------
    match /audit_logs/{logId} {
      allow read: if isAdmin() || sameBranch(resource.data.get('branchId', ''));
      allow create: if isAdmin() || sameBranch(request.resource.data.get('branchId', ''));
    }

    // ------------------------------------------------------------------
    // daily_tasks
    // ------------------------------------------------------------------
    match /daily_tasks/{taskId} {
      allow read: if isAdmin() || sameBranch(resource.data.get('branchId', ''));
      allow create: if isAdmin() || sameBranch(request.resource.data.get('branchId', ''));
      allow update, delete: if isAdmin() || sameBranch(resource.data.get('branchId', ''));
    }
  }
}
